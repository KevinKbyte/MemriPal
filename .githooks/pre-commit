#!/bin/sh
# Block staged secrets and EXIF-bearing images (MEM-004), and unformatted Python.
# Enable with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
git diff --cached --name-only --diff-filter=ACM -z | xargs -0 python scripts/precommit_scan.py || status=1

# --quiet exits 1 when matching staged files exist; skip ruff entirely otherwise.
# Note: ruff checks the working-tree copy, not the staged blob.
if ! git diff --cached --quiet --diff-filter=ACM -- '*.py'; then
    git diff --cached --name-only --diff-filter=ACM -z -- '*.py' \
        | xargs -0 uv run ruff format --check -- || status=1
fi

# MEM-018: any staged ADR change re-runs the ADR structure test before commit.
if ! git diff --cached --quiet --diff-filter=ACMRD -- 'docs/decisions/*'; then
    uv run pytest -q tests/test_decisions_structure.py || status=1
fi

# KB-041: KB anchor gate lives in agent-workflow; fail closed when it is absent.
AW="${AW:-$HOME/projects/agent-workflow}"
KB_GATE="$AW/scripts/kb_anchor_gate.py"
if [ ! -f "$KB_GATE" ]; then
    echo "pre-commit: KB-041 gate missing: $KB_GATE (set AW to the agent-workflow checkout)" >&2
    status=1
else
    python "$KB_GATE" --repo . || status=1
fi

# PDOC-005 (A18): docs/onboarding.html must match docs/onboarding.md; fail closed when absent.
DOCS_SYNC="$AW/githooks/pre_commit_docs_sync.py"
if [ ! -f "$DOCS_SYNC" ]; then
    echo "pre-commit: docs-sync gate missing: $DOCS_SYNC (set AW to the agent-workflow checkout)" >&2
    status=1
else
    python "$DOCS_SYNC" --root . || status=1
fi
exit $status
